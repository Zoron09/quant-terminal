.env
__pycache__/
*.pyc
data/screener_cache.db
.streamlit/secrets.toml
.venv/
.venv-secfsdstools/

# Wealthsimple export — live OAuth session + real trade history, never commit
tools/session.json
tools/ws_import_*.json
tools/needs_review.json
tools/account_balances.json
tools/open_positions.json
tools/*.tmp

# secfsdstools config — contains contact email; copy from .secfsdstools.cfg.example
.secfsdstools.cfg

# background scan job checkpoints (runtime artifacts)
data/scan_jobs/

# SEC ticker->CIK map cached by code33/ticker_lookup.py (~1MB, regenerable,
# refreshes itself weekly)
data/company_tickers.json

# News Scanner session history — today's headlines only, cleared on the first
# request of a new calendar day. Pure runtime state, plus the user's watchlist.
data/news_session.db
data/news_session.db-wal
data/news_session.db-shm
